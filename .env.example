# 灵矽控制台 API Key（Bearer）
LINX_API_KEY=

# 法官智能体 ID
LINX_AGENT_ID=

# 本机 MCP / 旁观 / 设备桥端口
PORT=8787

# 公网 HTTPS 地址（cloudflared / LAS），灵矽云端回调 MCP 用
# 例: https://xxxx.trycloudflare.com
MCP_PUBLIC_URL=http://127.0.0.1:8787

# 可选：固定本机伪 MAC。设备页、旁观屏、MCP 缺省房间键共用；不填则用 02:10:24:00:00:01
LINX_DEVICE_MAC=02:10:24:00:00:01
